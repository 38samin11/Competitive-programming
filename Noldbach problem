#include <iostream>
using namespace std;

int main() {
    int n, k;
    cin >> n >> k;

    int primes[1001] = {0};
    int primeList[200];
    int total = 0;

    for (int i = 2; i <= n; i++) {
        bool isPrime = true;
        for (int j = 2; j * j <= i; j++) {
            if (i % j == 0) {
                isPrime = false;
                break;
            }
        }
        if (isPrime) {
            primes[i] = 1;
            primeList[total++] = i;
        }
    }

    int count = 0;

    for (int i = 0; i < total - 1; i++) {
        int sum = primeList[i] + primeList[i + 1] + 1;
        if (sum <= n && primes[sum] == 1) {
            count++;
        }
    }

    if (count >= k)
        cout << "YES" << endl;
    else
        cout << "NO" << endl;

    return 0;
}
